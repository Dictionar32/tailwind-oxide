{
  "name": "tailwind-styled-v4",
  "version": "5.0.4",
  "packageManager": "npm@11.11.1",
  "engines": {
    "node": ">=20"
  },
  "description": "PRO Engine: styled-components + Tailwind CSS v4, zero-runtime compile, variant system, responsive props, plugin ecosystem",
  "author": "Dictionar32",
  "license": "MIT",
  "bin": {
    "tw": "dist/tw.js"
  },
  "keywords": [
    "tailwind",
    "tailwindcss",
    "styled-components",
    "css-in-js",
    "variants",
    "cva",
    "stitches",
    "panda-css",
    "twin.macro",
    "react",
    "next.js",
    "vite",
    "zero-runtime",
    "typescript",
    "shadcn",
    "radix",
    "headless-ui"
  ],
  "homepage": "https://github.com/Dictionar32/tailwind-styled-v4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dictionar32/tailwind-styled-v4.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "bugs": {
    "url": "https://github.com/Dictionar32/tailwind-styled-v4/issues"
  },
  "readme": "README.md",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "import": "./dist/compiler.mjs",
      "require": "./dist/compiler.js"
    },
    "./animate": {
      "types": "./dist/animate.d.ts",
      "import": "./dist/animate.mjs",
      "require": "./dist/animate.js"
    },
    "./scanner": {
      "types": "./dist/scanner.d.ts",
      "import": "./dist/scanner.mjs",
      "require": "./dist/scanner.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.mjs",
      "require": "./dist/engine.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.mjs",
      "require": "./dist/theme.js"
    },
    "./preset": {
      "types": "./dist/preset.d.ts",
      "import": "./dist/preset.mjs",
      "require": "./dist/preset.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.mjs",
      "require": "./dist/cli.js"
    },
    "./analyzer": {
      "types": "./dist/analyzer.d.ts",
      "import": "./dist/analyzer.mjs",
      "require": "./dist/analyzer.js"
    },
    "./shared": {
      "types": "./dist/shared.d.ts",
      "import": "./dist/shared.mjs",
      "require": "./dist/shared.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.mjs",
      "require": "./dist/runtime.js"
    },
    "./runtime-css": {
      "types": "./dist/runtime-css.d.ts",
      "import": "./dist/runtime-css.mjs",
      "require": "./dist/runtime-css.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.mjs",
      "require": "./dist/plugin.js"
    },
    "./plugin-api": {
      "types": "./dist/plugin-api.d.ts",
      "import": "./dist/plugin-api.mjs",
      "require": "./dist/plugin-api.js"
    },
    "./plugin-registry": {
      "types": "./dist/plugin-registry.d.ts",
      "import": "./dist/plugin-registry.mjs",
      "require": "./dist/plugin-registry.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.mjs",
      "require": "./dist/next.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.mjs",
      "require": "./dist/vite.js"
    },
    "./rspack": {
      "types": "./dist/rspack.d.ts",
      "import": "./dist/rspack.mjs",
      "require": "./dist/rspack.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.mjs",
      "require": "./dist/vue.js"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "import": "./dist/svelte.mjs",
      "require": "./dist/svelte.js"
    },
    "./syntax": {
      "types": "./dist/syntax.d.ts",
      "import": "./dist/syntax.mjs",
      "require": "./dist/syntax.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.mjs",
      "require": "./dist/testing.js"
    },
    "./storybook-addon": {
      "types": "./dist/storybook-addon.d.ts",
      "import": "./dist/storybook-addon.mjs",
      "require": "./dist/storybook-addon.js"
    },
    "./devtools": {
      "types": "./dist/devtools.d.ts",
      "import": "./dist/devtools.mjs",
      "require": "./dist/devtools.js"
    },
    "./atomic": {
      "types": "./dist/atomic.d.ts",
      "import": "./dist/atomic.mjs",
      "require": "./dist/atomic.js"
    },
    "./dashboard": {
      "types": "./dist/dashboard.d.ts",
      "import": "./dist/dashboard.mjs",
      "require": "./dist/dashboard.js"
    }
  },
  "scripts": {
    "build": "npm run build:packages && tsup --config tsup.config.ts",
    "build:packages": "turbo run build --continue",
    "build:rust": "cd native && cargo build --release",
    "build:dev": "npm run build:packages && tsup --config tsup.config.ts --sourcemap --watch",
    "build:release": "npm run build:packages && tsup --config tsup.config.ts --no-sourcemap",
    "verify:builds": "npm run build && npm run test:examples",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsup --config tsup.config.ts --watch",
    "test": "turbo run test --continue",
    "test:examples": "node examples/test-packages.mjs",
    "check": "turbo run check --continue && npm run check:types && npm run check:boundaries && npm run check:umbrella && npm run check:file-deps",
    "check:types": "tsc --noEmit",
    "check:boundaries": "depcruise --config dependency-cruiser.cjs packages",
    "check:umbrella": "node scripts/check-umbrella-exports.mjs",
    "graph:file-deps": "node scripts/graph/monorepo-file-deps.mjs",
    "check:file-deps": "node scripts/graph/monorepo-file-deps.mjs --check",
    "validate:deps": "node scripts/validate/dependency-matrix-check.mjs",
    "lint": "biome check --write .",
    "pack:check": "node scripts/check-pack-artifacts.mjs",
    "version:sync": "node scripts/version-sync.mjs",
    "schemas:generate": "node scripts/generate-json-schemas.mjs",
    "schemas:check": "node scripts/generate-json-schemas.mjs --check"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.7",
    "@types/node": "^20.19.37",
    "@types/react": "^19",
    "dependency-cruiser": "^16.10.4",
    "next": "^16.2.1",
    "tailwind-merge": "^3.5.0",
    "tsup": "^8",
    "turbo": "^2.1.3",
    "typescript": "^5",
    "vue": "^3.5.30"
  },
  "optionalDependencies": {
    "oxc-minify": "^0.120.0",
    "oxc-parser": "^0.120.0",
    "oxc-transform": "^0.120.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "@tailwind-styled/analyzer": "^5.0.4",
    "@tailwind-styled/animate": "^5.0.4",
    "@tailwind-styled/atomic": "^5.0.4",
    "@tailwind-styled/compiler": "^5.0.4",
    "@tailwind-styled/core": "^5.0.4",
    "@tailwind-styled/dashboard": "^5.0.4",
    "@tailwind-styled/devtools": "^5.0.4",
    "@tailwind-styled/engine": "^5.0.4",
    "@tailwind-styled/next": "^5.0.4",
    "@tailwind-styled/plugin": "^5.0.4",
    "@tailwind-styled/plugin-registry": "^5.0.4",
    "@tailwind-styled/preset": "^5.0.4",
    "@tailwind-styled/rspack": "^5.0.4",
    "@tailwind-styled/runtime": "^5.0.4",
    "@tailwind-styled/runtime-css": "^5.0.4",
    "@tailwind-styled/scanner": "^5.0.4",
    "@tailwind-styled/shared": "^5.0.4",
    "@tailwind-styled/storybook-addon": "^5.0.4",
    "@tailwind-styled/svelte": "^5.0.4",
    "@tailwind-styled/testing": "^5.0.4",
    "@tailwind-styled/theme": "^5.0.4",
    "@tailwind-styled/vite": "^5.0.4",
    "@tailwind-styled/vue": "^5.0.4",
    "create-tailwind-styled": "^5.0.4",
    "ts-pattern": "^5.9.0"
  }
}
