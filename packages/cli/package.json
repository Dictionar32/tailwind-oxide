{
  "name": "create-tailwind-styled",
  "version": "5.0.4",
  "description": "CLI scaffolding tool — npx create-tailwind-styled",
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-tailwind-styled": "./dist/index.js",
    "tailwind-styled": "./dist/index.js",
    "tw": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "build:dev": "tsup --config tsup.config.ts --sourcemap --watch",
    "build:release": "tsup --config tsup.config.ts --no-sourcemap",
    "check": "tsc --noEmit -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsup --config tsup.config.ts --watch",
    "pack:check": "node ../../scripts/check-pack-artifacts.mjs packages/cli",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsup": "^8",
    "typescript": "^5"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "@tailwind-styled/analyzer": "^5.0.4",
    "@tailwind-styled/compiler": "^5.0.4",
    "@tailwind-styled/engine": "^5.0.4",
    "@tailwind-styled/next": "^5.0.4",
    "@tailwind-styled/rspack": "^5.0.4",
    "@tailwind-styled/scanner": "^5.0.4",
    "@tailwind-styled/svelte": "^5.0.4",
    "@tailwind-styled/vite": "^5.0.4",
    "@tailwind-styled/vue": "^5.0.4",
    "commander": "^12.1.0",
    "inversify": "^8.1.0",
    "picocolors": "^1.1.1",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.3.6"
  }
}
