{
  "name": "@tailwind-styled/next",
  "version": "5.0.4",
  "description": "Next.js integration for tailwind-styled-v4 — withTailwindStyled, webpack/turbopack loaders",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:release": "tsup",
    "check": "tsc --noEmit -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsup --watch",
    "pack:check": "node ../../scripts/check-pack-artifacts.mjs packages/next",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@tailwind-styled/compiler": "^5.0.4",
    "@tailwind-styled/engine": "^5.0.4",
    "@tailwind-styled/plugin": "^5.0.4",
    "inversify": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "next": ">=14"
  },
  "devDependencies": {
    "@types/node": "^20",
    "next": ">=14",
    "tsup": "^8",
    "typescript": "^5"
  }
}
